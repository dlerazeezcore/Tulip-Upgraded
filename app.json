{
  "expo": {
    "name": "Tulip Booking",
    "slug": "tulip-booking",
    "version": "1.1.8",
    "scheme": "tulip",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/tulip-logo-full.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theesim.app",
      "userInterfaceStyle": "automatic",
      "icon": "./assets/icon.png",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.theesim.app",
      "versionCode": 10,
      "userInterfaceStyle": "automatic",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-android-foreground.png",
        "backgroundColor": "#1967D2"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/tulip-logo-full.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/tulip-mark-white.png",
          "imageWidth": 206,
          "resizeMode": "contain",
          "backgroundColor": "#1557B0",
          "dark": {
            "image": "./assets/tulip-mark-white.png",
            "backgroundColor": "#1557B0"
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon-android-foreground.png",
          "color": "#1967D2",
          "defaultChannel": "general"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}
