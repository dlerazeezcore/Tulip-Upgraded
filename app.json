{
  "expo": {
    "name": "Tulip Booking",
    "slug": "tulip-booking",
    "version": "1.0.0",
    "scheme": "tulip",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/tulip-logo-full.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tulip.booking",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.tulip.booking",
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/tulip-logo-full.png",
        "backgroundColor": "#1967D2"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/tulip-logo-full.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/tulip-logo-full.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1967D2",
          "dark": {
            "image": "./assets/tulip-logo-full.png",
            "backgroundColor": "#0B1120"
          }
        }
      ]
    ]
  }
}
